# Build-time settings for hosting the landing page as static files (for example on
# Cloudflare Pages). In Docker these are read at container start instead: see the
# `landing` service in docker-compose.yml. Every value has a local default.

# Where the live pieces are (no trailing slash).
# VITE_API_URL=https://api.example.com
# VITE_ADMIN_WEB_URL=https://admin.example.com
# VITE_ADMIN_MOBILE_URL=https://admin-app.example.com
# VITE_MEMBER_MOBILE_URL=https://member-app.example.com

# Android downloads. Leave empty (the default) to hide the buttons until a
# release exists, then point them at releases/latest/download/<file>.apk.
# VITE_APK_ADMIN_URL=https://github.com/OWNER/REPO/releases/latest/download/warriors-admin.apk
# VITE_APK_MEMBER_URL=https://github.com/OWNER/REPO/releases/latest/download/warriors-member.apk

# The site's own public address, so the social-preview image link is absolute.
# VITE_SITE_URL=https://warriors.example.com
