# Included in every location that sets its own add_header (nginx drops
# server-level add_header directives inside any location that declares one).
# The ${...} values come from the container's environment.
#
# The page may only call the API, and may only frame the two mobile apps.
# Styles allow 'unsafe-inline' because React sets style attributes.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_URL}; frame-src ${ADMIN_MOBILE_URL} ${MEMBER_MOBILE_URL}; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "SAMEORIGIN" always;
