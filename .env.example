# Optional overrides for docker-compose.yml. Copy to .env next to it.
# Everything has a working default, so you only need this to change something.

# Host ports
# BACKEND_PORT=5000
# ADMIN_WEB_PORT=8080
# ADMIN_MOBILE_PORT=8081
# MEMBER_MOBILE_PORT=8082
# DB_PORT=5433

# Browser origins the API accepts (comma-separated). Defaults to the three web
# apps above; change it if you serve them from other addresses.
# CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082

# Database password (also used inside the compose network)
# POSTGRES_PASSWORD=warriors

# Set a real secret anywhere other than your own machine (32+ characters):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET_KEY=

# Sample data and locked demo logins (default true here). Set false for a clean database.
# DEMO_MODE=true
# Enables POST /demo/reset (16+ characters) for a nightly reset job.
# DEMO_RESET_TOKEN=
# Enables admin sign-up when sent as the x-invite-code header.
# ADMIN_INVITE_CODE=
