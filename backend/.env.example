# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
# Secret used to sign JWTs (32+ characters in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=change-me

# --- Database ---------------------------------------------------------------
# Required in production. In development it defaults to backend/setup.sql:
#   postgres://postname:password@localhost:5432/postdb
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to true for hosted Postgres that requires TLS (Neon, Supabase, Render).
# DATABASE_SSL=false
# Optional Postgres schema (search_path). The test suite sets this itself.
# DATABASE_SCHEMA=

# --- Server -----------------------------------------------------------------
# PORT=5000
# Comma-separated browser origins allowed by CORS. Native apps are unaffected.
# CORS_ORIGINS=https://admin.example.com
# Run pending migrations on boot (npm run migrate does it manually).
# AUTO_MIGRATE=true
# How long issued JWTs stay valid (jsonwebtoken format).
# JWT_EXPIRES_IN=30d

# --- Admin accounts ---------------------------------------------------------
# POST /auth/sign-up/admin is disabled unless this is set. Callers must then
# send it in the x-invite-code header.
# ADMIN_INVITE_CODE=

# --- Payments (optional, integration not enabled yet) ------------------------
# CHAPA_SECRET_KEY=
# CHAPA_CALLBACK_URL=
