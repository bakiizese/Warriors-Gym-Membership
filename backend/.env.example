# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
# Secret used to sign JWTs (32+ characters in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=change-me

# --- Database ---------------------------------------------------------------
# Required in production. In development it defaults to backend/setup.sql:
#   postgres://postname:password@localhost:5432/postdb
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to true for hosted Postgres that requires TLS (Neon, Supabase, Render).
# DATABASE_SSL=false
# Optional Postgres schema (search_path). The test suite sets this itself.
# DATABASE_SCHEMA=

# --- Server -----------------------------------------------------------------
# PORT=5000
# Comma-separated browser origins allowed by CORS. Native apps are unaffected.
# CORS_ORIGINS=https://admin.example.com
# Run pending migrations on boot (npm run migrate does it manually).
# AUTO_MIGRATE=true
# How long issued JWTs stay valid (jsonwebtoken format).
# JWT_EXPIRES_IN=30d

# --- Uploads ----------------------------------------------------------------
# Where uploaded images and videos are stored (default: backend/uploads).
# Point at a mounted volume to keep them across deploys.
# UPLOADS_DIR=
# Largest accepted upload, in megabytes.
# UPLOAD_MAX_MB=100

# --- Admin accounts ---------------------------------------------------------
# POST /auth/sign-up/admin is disabled unless this is set. Callers must then
# send it in the x-invite-code header.
# ADMIN_INVITE_CODE=

# --- Demo mode --------------------------------------------------------------
# Seeds sample data into an empty database on boot and locks the demo logins.
# DEMO_MODE=false
# Enables POST /demo/reset (16+ characters); the nightly reset job sends it as
# the x-reset-token header.
# DEMO_RESET_TOKEN=
# Published logins. Defaults are fine for a public demo; never reuse them.
# DEMO_ADMIN_PHONE=0900000001
# DEMO_ADMIN_PASSWORD=demo1234
# DEMO_MEMBER_PHONE=0911000001
# DEMO_MEMBER_PASSWORD=demo1234

# --- Payments (optional, integration not enabled yet) ------------------------
# CHAPA_SECRET_KEY=
# CHAPA_CALLBACK_URL=
